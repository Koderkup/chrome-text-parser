{
 "manifest_version": "3",
 "name": "Double-click text parser",
 "description": "Sends text from html page",
 "permitions": [
    "actibeTab",
    "scripting",
    "tabs"
 ],
 "host_permissions": [
    "<all_urls>"
 ],
 "options_ui": {
    "page": "options.html",
    "open_in_tab": true
 },
 "background": {
    "service_worker": "background.js"
 },
 "content_scripts":[
    {
        "matches": [
            "<all_urls>"
        ],
        "js": [
            "content.js"
        ]
    }
 ]
       
}